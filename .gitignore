# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent / graph / verify junk
.codegraph/
.verify-tmp-*.mjs
.verify-*.mjs
.tmp-*.sh
scripts/.run-*.sh
scripts/.smoke-*.txt
lark-im-resources/
playwright-report/
test-results/

# agent runtime artifacts (regenerated locally)
workspace/.agent/trajectories/
workspace/.agent/handoffs/
workspace/.agent/inbox.json
workspace/.agent/memory/
workspace/.agent/workflow-state.json
workspace/.agent/crons.json
workspace/.agent/cron-log.jsonl
